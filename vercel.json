{
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/_kit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/ai-data/embedded-agents/",
      "destination": "/services/ai-data/multi-agent-orchestration/",
      "permanent": true
    }
  ]
}